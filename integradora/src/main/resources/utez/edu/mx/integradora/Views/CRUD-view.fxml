<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="utez.edu.mx.integradora.Controller.CRUDController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <children>

        <Label text="Directorio de Pacientes"/>

        <HBox spacing="10" alignment="CENTER">
            <children>
                <Button text="Nuevo" onAction="#onNuevo"/>
                <Button text="Actualizar" onAction="#onActualizar"/>
                <Button text="Cambiar Status" onAction="#onCambiarStatus"/>
                <Button text="Eliminar" onAction="#onEliminar"/>
                <Button text="Recargar" onAction="#onRecargar"/>
            </children>
        </HBox>

        <TableView fx:id="tvpacientes" prefHeight="500.0" prefWidth="600.0">
            <columns>
                <TableColumn fx:id="colCurp" text="CURP" prefWidth="120"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
                <TableColumn fx:id="colEdad" text="Edad" prefWidth="80"/>
                <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="120"/>
                <TableColumn fx:id="colAlergias" text="Alergias" prefWidth="150"/>
                <TableColumn fx:id="colActivo" text="Status" prefWidth="100"/>
            </columns>
        </TableView>

        <HBox spacing="10" alignment="CENTER">
            <children>
                <Label fx:id="lbltotal" text="Total: 0"/>
                <Label fx:id="lblactivos" text="Activos: 0"/>
                <Label fx:id="lblinactivos" text="Inactivos: 0"/>
            </children>
        </HBox>

        <Label fx:id="labeltxt"/>

    </children>
</VBox>