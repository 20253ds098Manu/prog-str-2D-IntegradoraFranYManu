<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="utez.edu.mx.integradora.Controller.formController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <children>

        <Label text="Formulario de Paciente" />
        <Label fx:id="labeldeproceso" />

        <TextField fx:id="txtcurp" promptText="Ingresa el CURP" />
        <TextField fx:id="txtnombre" promptText="Ingresa el nombre" />
        <TextField fx:id="txtedad" promptText="Ingresa la edad" />
        <TextField fx:id="txttelefono" promptText="Ingresa el teléfono" />
        <TextField fx:id="txtalergias" promptText="Ingresa alergias" />

        <Label fx:id="labeltxt" />

        <HBox alignment="CENTER" spacing="10">
            <children>
                <Button onAction="#onGuardar" text="Guardar" />
                <Button onAction="#onCancelar" text="Cancelar" />
            </children>
        </HBox>

    </children>
</VBox>